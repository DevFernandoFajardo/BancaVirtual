# --- Servidor ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- PostgreSQL (contenedor postgres_desarrolloweb en Docker) ---
# Ajusta usuario/clave a los que usaste al crear el contenedor.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=banca_virtual

# --- Seguridad ---
# Genera cada valor largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_SECONDS=3600
# Llave para cifrar DPI y NIT en la base de datos. Si la cambias, los datos ya guardados no se podran leer.
ENCRYPTION_KEY=cambia-esto-tambien
# Llave que usara la app administrativa de tu companero (header X-Service-Key)
SERVICE_API_KEY=cambia-esto-para-la-app-admin

# --- CORE / motor de evaluaciones (CreditPulse) ---
CORE_BASE_URL=http://creditpulse.somee.com/api/v1
# Pega aqui la API key (idealmente una nueva: la anterior quedo expuesta en un documento)
CORE_API_KEY=

# --- Demo: segundos que tarda en mostrarse el resultado de una solicitud (0 = inmediato) ---
EVALUACION_ESPERA_SEGUNDOS=20

# --- Banca simulada ---
MAX_TRANSFER_AMOUNT=50000
ALLOW_DEMO_DEPOSITS=true

# --- Usuario administrador inicial (se crea al arrancar si no existe) ---
SEED_ADMIN_EMAIL=admin@banca.local
SEED_ADMIN_PASSWORD=CambiaEstaClave123!

# CP Gestiones (API del banco): solo para registrar los productos/gestiones aceptados.
# El token es SECRETO: va SOLO aqui (Render), nunca en el frontend ni en GitHub.
CP_GESTIONES_TOKEN=
CP_GESTIONES_BASE_URL=https://cp-gestiones-api.onrender.com/api/v1

# --- API externa de pago de servicios (docs/API-SERVICIOS-EXTERNA.md). OBLIGATORIA: sin SERVICIOS_API_URL no hay pago de servicios.
# Apunta al proveedor simulado (carpeta proveedor-servicios-sim) desplegado aparte, o a cualquier API que cumpla el contrato.
SERVICIOS_API_URL=
SERVICIOS_API_KEY=
SERVICIOS_API_NOMBRE=API-SERVICIOS
# json (por omisión) o xml: formato de los mensajes con el proveedor
SERVICIOS_API_FORMATO=json
SERVICIOS_API_TIMEOUT_MS=45000

# --- Notificaciones push (Web Push). Genera las llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
