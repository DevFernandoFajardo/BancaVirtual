# --- Servidor ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- PostgreSQL (contenedor postgres_desarrolloweb en Docker) ---
# Ajusta usuario/clave a los que usaste al crear el contenedor.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=banca_virtual

# --- Seguridad ---
# Genera cada valor largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_SECONDS=3600
# Llave para cifrar DPI y NIT en la base de datos. Si la cambias, los datos ya guardados no se podran leer.
ENCRYPTION_KEY=cambia-esto-tambien
# Llave que usara la app administrativa de tu companero (header X-Service-Key)
SERVICE_API_KEY=cambia-esto-para-la-app-admin

# --- CORE / motor de evaluaciones (CreditPulse) ---
CORE_BASE_URL=http://creditpulse.somee.com/api/v1
# Pega aqui la API key (idealmente una nueva: la anterior quedo expuesta en un documento)
CORE_API_KEY=

# --- Demo: segundos que tarda en mostrarse el resultado de una solicitud (0 = inmediato) ---
EVALUACION_DEMORA_SEGUNDOS=60

# --- Banca simulada ---
MAX_TRANSFER_AMOUNT=50000
ALLOW_DEMO_DEPOSITS=true

# --- Usuario administrador inicial (se crea al arrancar si no existe) ---
SEED_ADMIN_EMAIL=admin@banca.local
SEED_ADMIN_PASSWORD=CambiaEstaClave123!
